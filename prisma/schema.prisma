generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum StatementStatus {
  pending
  processing
  parsed
  failed
}

enum TransactionType {
  debit
  credit
}

enum TransactionCategory {
  food
  transport
  rent
  utilities
  subscriptions
  shopping
  entertainment
  income
  other
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(user)
  emailVerifiedAt DateTime?

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  uploadStatements        UploadStatement[]
  transactions            Transaction[]
  corrections             TransactionCorrection[]
  budgets                 Budget[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UploadStatement {
  id            String          @id @default(uuid())
  userId        String
  filename      String
  contentHash   String
  storagePath   String
  status        StatementStatus @default(pending)
  failureReason String?
  uploadedAt    DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, contentHash])
  @@index([userId])
  @@map("upload_statements")
}

model Transaction {
  id          String                  @id @default(uuid())
  userId      String
  statementId String
  date        DateTime
  description String
  amount      Int
  type        TransactionType
  category    TransactionCategory
  confidence  Float
  createdAt   DateTime                @default(now())
  corrections TransactionCorrection[]

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadStatement UploadStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([statementId])
  @@map("transactions")
}

model TransactionCorrection {
  id               String              @id @default(uuid())
  transactionId    String
  userId           String
  previousCategory TransactionCategory
  newCategory      TransactionCategory
  correctedAt      DateTime            @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Budget {
  id          String              @id @default(uuid())
  userId      String
  category    TransactionCategory
  monthlyLimit Int
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}
